jwt:
  secret: "some_secure_secret"

db:
  connection_url: "postgres://postgres:postgres@localhost/mia_development"
  schema: "public"

tmdb:
  authorization_token: "some token"
  refresh_interval: 24h

openrouter:
  api_key: "some key"
  model: 'openrouter/free'
  title_model: 'some cheaper model'  # optional; titles conversations with a cheaper model, must differ from model; absent disables titling
  max_tokens: 1500
  reasoning:            # optional; absent disables reasoning
    effort: low         # low | medium | high | xhigh | max
  data_policy: allow    # optional, default deny: allow | deny | zdr. 'openrouter/free' needs allow

assistant:              # optional; each limit defaults as shown and must be at least 1
  mia_search_limit: 30  # most results per page of one mia_search call (also the default page size)
  mia_details_limit: 60 # ids of one mia_details call
  max_tool_rounds: 8    # rounds of tool calls in one Exchange

logging:
  level: "trace"

media:
  unset_title: "Title not found!"

images:
  store_path: "some path"